#!/usr/bin/env bash
# 生成先repositoryのbaselineを検査する。`mise run validate`とBaseline CIの両方から呼ぶ。
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

status=0

error() {
  local message="$1"
  local file="${2:-}"
  if [[ -n "${GITHUB_ACTIONS:-}" ]]; then
    if [[ -n "$file" ]]; then
      echo "::error file=$file::$message"
    else
      echo "::error::$message"
    fi
  else
    echo "[error] $message${file:+: $file}" >&2
  fi
  status=1
}

required_files=(
  "AGENTS.md"
  "CLAUDE.md"
  "README.md"
  "SECURITY.md"
  ".editorconfig"
  ".gitattributes"
  ".gitignore"
  "mise.toml"
  "mise.lock"
  "renovate.json"
  ".github/dependabot.yml"
  ".github/hyd3-baseline.yml"
  ".github/labels.yml"
  ".github/ISSUE_TEMPLATE/bug.yml"
  ".github/ISSUE_TEMPLATE/chore.yml"
  ".github/ISSUE_TEMPLATE/feature.yml"
  ".github/ISSUE_TEMPLATE/documentation.yml"
  ".github/ISSUE_TEMPLATE/test.yml"
  ".github/ISSUE_TEMPLATE/security.yml"
  ".github/PULL_REQUEST_TEMPLATE/default.md"
  ".github/workflows/ci.yml"
  ".github/workflows/dependabot-triage.yml"
  ".github/workflows/automerge-dependabot.yml"
  ".github/workflows/github-actions-static-checks.yml"
  ".github/workflows/sync-labels.yml"
  "docs/operations/manual-tasks.md"
  "docs/operations/repo-baseline.md"
  "scripts/check-baseline"
  "scripts/ci-changes"
  "scripts/docs-toc"
  "scripts/docs-toc-targets.json"
  "scripts/sync-labels"
  "scripts/validate-template"
)
for file in "${required_files[@]}"; do
  [[ -f "$file" ]] || error "Required baseline file is missing" "$file"
done

# PRではbaseからheadまでの差分、それ以外では未commitの変更を検査する。
if [[ -n "${BASE_SHA:-}" && -n "${HEAD_SHA:-}" ]]; then
  git diff --check "$BASE_SHA" "$HEAD_SHA" || error "Whitespace errors found"
else
  git diff --check || error "Whitespace errors found"
  git diff --cached --check || error "Whitespace errors found in staged changes"
fi

# .gitignoreで除外したlocal fileは対象外にし、追跡済みと追跡予定のfileだけを見る。
forbidden='(^|/)(auth|oauth|token|credential|credentials|secret|secrets|session|sessions|hosts)\.(json|ya?ml|toml|ini|env|txt)$|(^|/)\.env($|\.)'
matches="$(git ls-files --cached --others --exclude-standard |
  grep -Ei "$forbidden" |
  grep -Eiv '(^|/)\.env\.example$' || true)"
if [[ -n "$matches" ]]; then
  echo "$matches"
  error "Potential secret or local state file names found"
fi

missing_permissions="$(find .github/workflows -type f \( -name '*.yml' -o -name '*.yaml' \) -exec awk '
  FNR == 1 {
    if (seen && !has) print file
    file = FILENAME
    has = 0
    seen = 1
  }
  /^permissions:/ { has = 1 }
  END { if (seen && !has) print file }
' {} +)"
if [[ -n "$missing_permissions" ]]; then
  echo "$missing_permissions"
  error "Workflow files must declare permissions explicitly"
fi

./scripts/validate-template || status=1

exit "$status"
