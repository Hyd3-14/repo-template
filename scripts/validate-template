#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

python3 - <<'PY'
from __future__ import annotations

import re
from pathlib import Path

expected_labels = {
    "type: feature",
    "type: bug",
    "type: chore",
    "type: documentation",
    "type: test",
    "type: security",
    "priority: P0",
    "priority: P1",
    "priority: P2",
    "area: app",
    "area: database",
    "area: dependency",
    "area: devex",
    "area: ci",
    "area: deployment",
}
expected_forms = {"bug.yml", "feature.yml", "chore.yml"}
expected_heading_sets = {
    "ja": [
        "## 関連Issue",
        "## 概要",
        "## 変更点",
        "## 動作確認",
        "## 補足",
    ],
    "en": [
        "## Related issue",
        "## Summary",
        "## Changes",
        "## Verification",
        "## Notes",
    ],
}

def fail(message: str) -> None:
    raise SystemExit(f"[error] {message}")

required = [
    Path("README.md"),
    Path("AGENTS.md"),
    Path("SECURITY.md"),
    Path(".editorconfig"),
    Path(".gitattributes"),
    Path(".gitignore"),
    Path(".github/dependabot.yml"),
    Path(".github/hyd3-baseline.yml"),
    Path(".github/labels.yml"),
    Path(".github/workflows/ci.yml"),
    Path(".github/workflows/dependency-review.yml"),
    Path(".github/workflows/dependabot-triage.yml"),
    Path(".github/workflows/automerge-dependabot.yml"),
    Path(".github/workflows/github-actions-static-checks.yml"),
    Path(".github/PULL_REQUEST_TEMPLATE/default.md"),
    Path(".github/pull_request_template.md"),
]
for path in required:
    if not path.is_file():
        fail(f"必須ファイルがありません: {path}")

forms_dir = Path(".github/ISSUE_TEMPLATE")
actual_forms = {path.name for path in forms_dir.iterdir() if path.is_file() and path.name != "config.yml"}
if actual_forms != expected_forms:
    fail(f"Issue Formの構成が標準と異なります: {sorted(actual_forms)}")

legacy_names = {"bug_report.yml", "feature_request.yml"}
if any((forms_dir / name).exists() for name in legacy_names):
    fail("旧Issue Formのファイル名がactive配置に残っています")

for path in sorted(forms_dir.glob("*.yml")):
    if path.name == "config.yml":
        continue
    text = path.read_text(encoding="utf-8")
    titles = re.findall(r"^title:\s*(.*?)\s*$", text, flags=re.MULTILINE)
    if titles != ['""']:
        fail(f"Issue Formのtitleは空文字列である必要があります: {path}")
    if re.search(r"\[(?:Bug|Feature|Chore)\]:|^title:\s*[\"'](?:bug|feat|chore):", text, flags=re.MULTILINE):
        fail(f"Issue Formに種別prefixが残っています: {path}")

pr_template = Path(".github/PULL_REQUEST_TEMPLATE/default.md")
headings = [line for line in pr_template.read_text(encoding="utf-8").splitlines() if line.startswith("## ")]
if headings not in expected_heading_sets.values():
    fail(f"PR templateの見出し構成が標準と異なります: {headings}")
auto_loaded_template = Path(".github/pull_request_template.md")
if auto_loaded_template.read_text(encoding="utf-8") != pr_template.read_text(encoding="utf-8"):
    fail("自動読み込みPR templateがcanonical templateと一致しません")
for stale in [Path(".github/pull_request_template.md"), Path(".github/PULL_REQUEST_TEMPLATE.md")]:
    if stale == auto_loaded_template:
        continue
    if stale.exists():
        fail(f"旧PR templateのactive配置が残っています: {stale}")

labels = []
label_pattern = re.compile(r"^\s*-\s+name:\s*([\"'])(.*?)\1\s*$")
for line in Path(".github/labels.yml").read_text(encoding="utf-8").splitlines():
    match = label_pattern.match(line)
    if match:
        labels.append(match.group(2))
if set(labels) != expected_labels or len(labels) != len(expected_labels):
    fail(f"label構成が標準と異なります: {labels}")

legacy_label_references = {
    "type" + ": docs",
    "area" + ": github",
    "area" + ": config",
    "area" + ": security",
    "area" + ": ai-agent",
    "status" + ": blocked",
    "risk" + ": security",
    "risk" + ": supply-chain",
    "size" + ": s",
    "10" + ": type/feature",
    "00" + ": needs-triage",
    "20" + ": area/dependencies",
    "60" + ": deps/major",
    "30" + ": status/needs-human-review",
}
legacy_label_patterns = {
    legacy: re.compile(
        rf"(?<![A-Za-z0-9_-]){re.escape(legacy)}(?![A-Za-z0-9_-])"
    )
    for legacy in legacy_label_references
}
for path in sorted(Path(".").rglob("*")):
    if not path.is_file() or ".git" in path.parts or path == Path(__file__):
        continue
    try:
        text = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        continue
    for legacy, pattern in legacy_label_patterns.items():
        if pattern.search(text):
            fail(f"旧label参照が残っています: {path}: {legacy}")

marker = Path(".github/hyd3-baseline.yml").read_text(encoding="utf-8")
if not re.search(r'^branch_naming:\s*["\']?<type>/<issue-number>-<short-summary>["\']?\s*$', marker, flags=re.MULTILINE):
    fail("branch_namingが標準と一致しません")
if not re.search(r'^actions_static_checks:\s*\.github/workflows/github-actions-static-checks\.yml\s*$', marker, flags=re.MULTILINE):
    fail("actions_static_checksが標準と一致しません")
for key, value in {
    "external_action_ref": "full-40-character-sha",
    "checkout_persist_credentials": "false",
    "job_permissions": "explicit",
    "job_timeout_minutes": "required",
}.items():
    if not re.search(rf'^\s+{re.escape(key)}:\s*{re.escape(value)}\s*$', marker, flags=re.MULTILINE):
        fail(f"Actions policyの{key}が標準と一致しません")

dependabot = Path(".github/dependabot.yml").read_text(encoding="utf-8")
if dependabot.count("default-days: 7") != 3:
    fail("Dependabotの全updaterに7日間のcooldownが必要です")

static_checks = Path(".github/workflows/github-actions-static-checks.yml").read_text(encoding="utf-8")
for tool in ["actionlint", "zizmor", "ghalint", "pinact"]:
    if not re.search(rf'^\s+name:\s*{re.escape(tool)}\s*$', static_checks, flags=re.MULTILINE):
        fail(f"GitHub Actions static checksに{tool} jobが必要です")

automerge = Path(".github/workflows/automerge-dependabot.yml").read_text(encoding="utf-8")
for required_check in ["Baseline static checks", "Dependency Review", "GitHub Actions Static Checks"]:
    if required_check not in automerge:
        fail(f"Dependabot auto-mergeのrequired checkが不足しています: {required_check}")
if re.search(r"github\.actor\s*==\s*['\"]dependabot\[bot\]['\"]", automerge):
    fail("Dependabot auto-mergeでspoof可能なgithub.actor判定を使わないでください")
triage = Path(".github/workflows/dependabot-triage.yml").read_text(encoding="utf-8")
if re.search(r"github\.actor\s*==\s*['\"]dependabot\[bot\]['\"]", triage):
    fail("Dependabot triageでspoof可能なgithub.actor判定を使わないでください")
if "Dependabot auto-merge eligibility" not in triage or "outputs:" not in triage or "update_type:" not in triage:
    fail("Dependabot triageにauto-merge eligibility checkが必要です")
workflow_run_section = automerge.split("  pull_request_target:", 1)[0]
if re.search(r"^\s+branches:", workflow_run_section, flags=re.MULTILINE):
    fail("workflow_runにhead branchを誤って制限するbranches filterを置かないでください")
after_checks_section = automerge.split("  automerge-after-checks:", 1)[1]
if "fetch-metadata@" in after_checks_section:
    fail("workflow_run経路でdependabot/fetch-metadataを実行しないでください")
for marker in [
    "Dependabot Triage",
    "Dependabot auto-merge eligibility",
    "steps.pr.outputs.base_ref == 'main'",
    "steps.pr.outputs.base_repo == github.repository",
    "steps.pr.outputs.head_repo == github.repository",
]:
    if marker not in automerge:
        fail(f"Dependabot workflow_runの再検証条件が不足しています: {marker}")

for path in sorted(Path(".github/workflows").glob("*.y*ml")):
    workflow = path.read_text(encoding="utf-8")
    if not re.search(r'^permissions:', workflow, flags=re.MULTILINE):
        fail(f"workflowにpermissionsが必要です: {path}")
    checkout_count = len(re.findall(r'^\s+uses:\s+actions/checkout@', workflow, flags=re.MULTILINE))
    persist_false_count = len(re.findall(r'^\s+persist-credentials:\s*false\s*$', workflow, flags=re.MULTILINE))
    if checkout_count != persist_false_count:
        fail(f"actions/checkoutごとにpersist-credentials: falseが必要です: {path}")
    for line_number, line in enumerate(workflow.splitlines(), start=1):
        match = re.match(r'^\s+uses:\s*([^\s#]+)(?:\s+#\s*(.*?))?\s*$', line)
        if not match:
            continue
        action, annotation = match.groups()
        if action.startswith("./") or action.startswith("docker://"):
            continue
        if "@" not in action:
            fail(f"外部Actionのrefがありません: {path}:{line_number}")
        ref = action.rsplit("@", 1)[1]
        if not re.fullmatch(r"[0-9a-f]{40}", ref):
            fail(f"外部Actionはfull 40-character SHAが必要です: {path}:{line_number}")
        if not annotation or not re.search(r"v?\d+\.\d+\.\d+", annotation):
            fail(f"外部Actionのversion annotationが必要です: {path}:{line_number}")

print("[OK] repository template contract")
PY
