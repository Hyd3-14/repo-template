#!/usr/bin/env python3
"""Sync GitHub labels from .github/labels/labels.yml.

The parser intentionally supports the simple label YAML shape used by this
template so the script can run with the Python standard library only.
"""

from __future__ import annotations

import argparse
import ast
import json
import subprocess
import sys
from pathlib import Path


DEFAULT_FILE = Path(".github/labels/labels.yml")


def parse_scalar(value: str) -> str:
    value = value.strip()
    if not value:
        return ""
    if value[0] in {"'", '"'}:
        return str(ast.literal_eval(value))
    return value


def load_labels(path: Path) -> list[dict[str, str]]:
    labels: list[dict[str, str]] = []
    current: dict[str, str] | None = None

    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("- "):
            if current:
                labels.append(current)
            current = {}
            line = line[2:].strip()
            if line:
                key, value = line.split(":", 1)
                current[key.strip()] = parse_scalar(value)
            continue
        if current is None:
            raise SystemExit(f"Invalid label YAML near: {raw_line}")
        key, value = line.split(":", 1)
        current[key.strip()] = parse_scalar(value)

    if current:
        labels.append(current)

    required = {"name", "color", "description"}
    for label in labels:
        missing = required - label.keys()
        if missing:
            raise SystemExit(f"Label {label.get('name', '<unknown>')} is missing: {', '.join(sorted(missing))}")
        label["color"] = label["color"].lstrip("#").lower()
    return labels


def run_gh(args: list[str]) -> str:
    completed = subprocess.run(["gh", *args], check=True, text=True, capture_output=True)
    return completed.stdout


def remote_labels(repo: str) -> dict[str, dict[str, str]]:
    output = run_gh(["label", "list", "--repo", repo, "--limit", "1000", "--json", "name,color,description"])
    labels = json.loads(output)
    return {label["name"]: label for label in labels}


def main() -> int:
    parser = argparse.ArgumentParser(description="Sync GitHub labels from a local labels.yml file.")
    parser.add_argument("--repo", required=True, help="GitHub repository in OWNER/REPO form.")
    parser.add_argument("--file", default=str(DEFAULT_FILE), help="Label definition file.")
    parser.add_argument("--apply", action="store_true", help="Create or update labels on GitHub.")
    parser.add_argument("--dry-run", action="store_true", help="Show changes without applying them.")
    args = parser.parse_args()

    apply = args.apply
    if args.dry_run and args.apply:
        raise SystemExit("Use either --dry-run or --apply, not both.")
    if not args.dry_run and not args.apply:
        args.dry_run = True

    desired = load_labels(Path(args.file))
    current = remote_labels(args.repo)
    desired_names = {label["name"] for label in desired}

    creates: list[dict[str, str]] = []
    updates: list[dict[str, str]] = []
    unchanged = 0

    for label in desired:
        remote = current.get(label["name"])
        if remote is None:
            creates.append(label)
            continue
        if (
            remote.get("color", "").lower() != label["color"]
            or (remote.get("description") or "") != label["description"]
        ):
            updates.append(label)
            continue
        unchanged += 1

    stale = sorted(set(current) - desired_names)

    print(f"repo: {args.repo}")
    print(f"file: {args.file}")
    print(f"mode: {'apply' if apply else 'dry-run'}")
    print(f"create: {len(creates)}")
    print(f"update: {len(updates)}")
    print(f"unchanged: {unchanged}")
    print(f"stale: {len(stale)}")

    for action, labels in (("create", creates), ("update", updates)):
        for label in labels:
            print(f"{action}: {label['name']}")
            if not apply:
                continue
            if action == "create":
                run_gh([
                    "label",
                    "create",
                    label["name"],
                    "--repo",
                    args.repo,
                    "--color",
                    label["color"],
                    "--description",
                    label["description"],
                ])
            else:
                run_gh([
                    "label",
                    "edit",
                    label["name"],
                    "--repo",
                    args.repo,
                    "--color",
                    label["color"],
                    "--description",
                    label["description"],
                ])

    for name in stale:
        print(f"stale: {name}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
