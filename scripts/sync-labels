#!/usr/bin/env python3
""".github/labels.ymlとGitHub labelsの差分を確認・同期する。"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path
from urllib.parse import quote


def run_gh(args: list[str]) -> str:
    completed = subprocess.run(
        ["gh", *args],
        check=True,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    return completed.stdout


def parse_labels(path: Path) -> list[dict[str, str]]:
    labels: list[dict[str, str]] = []
    current: dict[str, str] | None = None

    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("- "):
            if current:
                labels.append(current)
            current = {}
            line = line[2:].strip()
            if line:
                key, value = parse_pair(line, path)
                current[key] = value
            continue
        if current is None:
            raise SystemExit(f"{path}: expected '- name: ...' before '{line}'")
        key, value = parse_pair(line, path)
        current[key] = value

    if current:
        labels.append(current)

    for label in labels:
        missing = {"name", "color", "description"} - label.keys()
        if missing:
            raise SystemExit(f"{path}: label entry missing {sorted(missing)}: {label}")
        label["color"] = label["color"].lstrip("#")
    return labels


def parse_pair(line: str, path: Path) -> tuple[str, str]:
    if ":" not in line:
        raise SystemExit(f"{path}: invalid label line: {line}")
    key, value = line.split(":", 1)
    value = value.strip()
    if (value.startswith("'") and value.endswith("'")) or (
        value.startswith('"') and value.endswith('"')
    ):
        value = value[1:-1]
    return key.strip(), value


def existing_labels(repo: str) -> dict[str, dict[str, str]]:
    output = run_gh(["api", f"repos/{repo}/labels", "--paginate"])
    labels = json.loads(output or "[]")
    return {item["name"]: item for item in labels}


def sync(repo: str, labels: list[dict[str, str]], apply: bool, prune: bool) -> None:
    current = existing_labels(repo)
    desired_names = {label["name"] for label in labels}

    for label in labels:
        name = label["name"]
        existing = current.get(name)
        if existing is None:
            print(f"CREATE {name} #{label['color']} - {label['description']}")
            if apply:
                run_gh(
                    [
                        "api",
                        "--method",
                        "POST",
                        f"repos/{repo}/labels",
                        "-f",
                        f"name={name}",
                        "-f",
                        f"color={label['color']}",
                        "-f",
                        f"description={label['description']}",
                    ]
                )
            continue

        needs_update = (
            existing.get("color", "").lower() != label["color"].lower()
            or existing.get("description", "") != label["description"]
        )
        if needs_update:
            print(f"UPDATE {name} #{label['color']} - {label['description']}")
            if apply:
                run_gh(
                    [
                        "api",
                        "--method",
                        "PATCH",
                        f"repos/{repo}/labels/{quote(name, safe='')}",
                        "-f",
                        f"new_name={name}",
                        "-f",
                        f"color={label['color']}",
                        "-f",
                        f"description={label['description']}",
                    ]
                )
        else:
            print(f"OK {name}")

    stale_names = sorted(set(current) - desired_names)
    for name in stale_names:
        if prune:
            print(f"DELETE {name}")
            if apply:
                run_gh(
                    [
                        "api",
                        "--method",
                        "DELETE",
                        f"repos/{repo}/labels/{quote(name, safe='')}",
                    ]
                )
        else:
            print(f"STALE {name}")

    if stale_names and apply and not prune:
        print("stale labels are retained; pass --prune only after migration review")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--repo", required=True, help="GitHub repository as OWNER/REPO")
    parser.add_argument("--file", default=".github/labels.yml")
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument(
        "--prune",
        action="store_true",
        help="宣言にないGitHub labelsを削除候補として扱う",
    )
    args = parser.parse_args()

    if args.apply and args.dry_run:
        parser.error("--apply and --dry-run are mutually exclusive")
    labels = parse_labels(Path(args.file))
    sync(args.repo, labels, apply=args.apply, prune=args.prune)
    if not args.apply:
        print("dry-run: pass --apply to mutate GitHub labels")
    return 0


if __name__ == "__main__":
    sys.exit(main())
